import Ddr3.Ctrl
-- The scheduler never breaks a JEDEC timing rule, and serves a due refresh promptly:
-- kernel-checked, for every input sequence.
--
-- The machine: the scheduler of the controller (`Sched.step`, the very function
-- `Ctrl.step` uses), on the arty timing record, with its control state (sst, stimer, swe,
-- refPend) as numbers, driven by arbitrary inputs every cycle (a refresh falling due, a
-- request, write or read), in service (`on`). Beside it a monitor in the style of the
-- behavioural model (`Ddr3.Model`), with every bank merged into one (the scheduler has one
-- bank open at a time, so this is stronger): cycles since the last ACT, PRE, RD/WR (and
-- whether it was a WR), REF, whether a row is open, and how long a refresh has been
-- pending without a REF (`age`), all capped. Its output is whether this cycle's command
-- breaks a rule: tRCD, tRP, tRAS, tRC, tRFC, the write recovery tWRP, tRTP, a command to a
-- closed bank, an ACT to an open one, a REF with a row open, or a refresh pending for
-- more than `SP.ageMax` cycles.
--
-- The proof: the reachable states are computed (a breadth-first search, by evaluation);
-- the kernel checks by evaluation that the initial state is among them, that every input
-- from every one of them leads to one of them, and that no step from them breaks a rule
-- (`SP.ok_true`). Then the set is an invariant (`Mealy.invariant`), and no step ever
-- breaks a rule (`SP.safe`).

def SP.t : Timing := Timing.arty
def SP.cap : Nat := 17
def SP.ageCap : Nat := 40
def SP.ageMax : Nat := 18

-- the scheduler's control state, as numbers: sst, stimer, swe, refPend
structure SPSc where
  sst : Nat
  stimer : Nat
  swe : Nat
  refPend : Nat
structure SPMon where
  sAct : Nat
  sPre : Nat
  sRw : Nat
  wasWr : Bool
  sRef : Nat
  open : Bool
  age : Nat
structure SPS where
  sc : SPSc
  mon : SPMon
-- the inputs: a refresh falls due, a request, it is a write
structure SPI where
  refDue : Bool
  valid : Bool
  we : Bool

def SP.base : St HwTy.El := Bundle.ofEl St.bundle (Ctrl.init SP.t)
def SP.st (c : SPSc) : St HwTy.El :=
  St.mk (SP.base).phase (SP.base).timer (SP.base).step (SP.base).rstN (SP.base).cke (SP.base).ras (SP.base).cas (SP.base).wen (SP.base).ba (SP.base).a (BitVec.ofNat 2 c.sst) (BitVec.ofNat 8 c.stimer) (BitVec.ofNat 1 c.swe) (SP.base).sba (SP.base).srow (SP.base).scol (SP.base).wdata (SP.base).wdm (SP.base).refCnt (BitVec.ofNat 1 c.refPend) (SP.base).wrHist (SP.base).rdHist (SP.base).prevRaw (SP.base).prevAl0 (SP.base).prevAl1 (SP.base).cst (SP.base).ctap (SP.base).cwin (SP.base).hits0 (SP.base).hits1 (SP.base).lat0 (SP.base).lat1 (SP.base).map0 (SP.base).map1 (SP.base).cpos (SP.base).run0s (SP.base).run0l (SP.base).run1s (SP.base).run1l (SP.base).best0s (SP.base).best0l (SP.base).best0p (SP.base).best1s (SP.base).best1l (SP.base).best1p (SP.base).slip0 (SP.base).slip1 (SP.base).tap0 (SP.base).tap1 (SP.base).latR (SP.base).dly0 (SP.base).dly1 (SP.base).calDone (SP.base).calFail (SP.base).dlyLd
def SP.bit (b : Bool) : HwTy.El Bit := Bool.toBits b
def SP.req (x : SPI) : Req HwTy.El :=
  Req.mk (SP.bit x.valid) (SP.bit x.we) (BitVec.ofNat 24 0) (BitVec.ofNat 128 0) (BitVec.ofNat 16 0)

-- commands: 0 NOP, 1 ACT, 2 RD, 3 WR, 4 PRE, 5 REF, 6 other
def SP.kind (ras cas wen : Nat) : Nat :=
  match Nat.beq ras 1, Nat.beq cas 1, Nat.beq wen 1 with
  | .true, .true, .true => 0
  | .false, .true, .true => 1
  | .true, .false, .true => 2
  | .true, .false, .false => 3
  | .false, .true, .false => 4
  | .false, .false, .true => 5
  | _, _, _ => 6

def SP.capped (k : Nat) : Nat := match Nat.lt k SP.cap with
  | .true => k
  | .false => SP.cap
def SP.since (now : Bool) (k : Nat) : Nat := match now with
  | .true => 1
  | .false => SP.capped (Nat.succ k)
def SP.ge (k m : Nat) : Bool := Bool.not (Nat.lt k m)

-- does command `c` break a rule, given the monitor
def SP.bad (m : SPMon) (c : Nat) : Bool :=
  let t := SP.t;
  let isAct := Nat.beq c 1;
  let isRw := Bool.or (Nat.beq c 2) (Nat.beq c 3);
  let isPre := Nat.beq c 4;
  let isRef := Nat.beq c 5;
  let any := Bool.not (Nat.beq c 0);
  Bool.or (Nat.beq c 6)
    (Bool.or (Bool.and any (Bool.not (SP.ge m.sRef t.tRFC)))
    (Bool.or (Bool.and isAct (Bool.or m.open (Bool.or (Bool.not (SP.ge m.sPre t.tRP)) (Bool.not (SP.ge m.sAct t.tRC)))))
    (Bool.or (Bool.and isRw (Bool.or (Bool.not m.open) (Bool.not (SP.ge m.sAct t.tRCD))))
    (Bool.or (Bool.and isPre (Bool.or (Bool.not (SP.ge m.sAct t.tRAS))
      (match m.wasWr with
        | .true => Bool.not (SP.ge m.sRw t.tWRP)
        | .false => Bool.not (SP.ge m.sRw t.tRTP))))
    (Bool.and isRef (Bool.or m.open (Bool.not (SP.ge m.sPre t.tRP))))))))

def SP.monNext (m : SPMon) (c : Nat) (pendNext : Bool) : SPMon :=
  let isRw := Bool.or (Nat.beq c 2) (Nat.beq c 3);
  SPMon.mk (SP.since (Nat.beq c 1) m.sAct) (SP.since (Nat.beq c 4) m.sPre) (SP.since isRw m.sRw)
    (match isRw with
      | .true => Nat.beq c 3
      | .false => m.wasWr)
    (SP.since (Nat.beq c 5) m.sRef)
    (match Nat.beq c 1, Nat.beq c 4 with
      | .true, _ => .true
      | _, .true => .false
      | _, _ => m.open)
    (match Nat.beq c 5, pendNext with
      | .true, _ => 0
      | _, .false => 0
      | _, .true => (match Nat.lt m.age SP.ageCap with
        | .true => Nat.succ m.age
        | .false => SP.ageCap))

-- one step: the scheduler (on), then the monitor on the command it presents next
def SP.step (s : SPS) (x : SPI) : SPS × Bool :=
  let sn := Sched.step SP.t (SP.st s.sc) (SP.bit .true) (SP.bit x.refDue) (SP.req x);
  let c := SP.kind (BitVec.toNat sn.cmd.ras) (BitVec.toNat sn.cmd.cas) (BitVec.toNat sn.cmd.wen);
  let pend := Nat.beq (BitVec.toNat sn.refPend) 1;
  let m := SP.monNext s.mon c pend;
  (SPS.mk (SPSc.mk (BitVec.toNat sn.sst) (BitVec.toNat sn.stimer) (BitVec.toNat sn.swe) (BitVec.toNat sn.refPend)) m,
    Bool.or (SP.bad s.mon c) (Nat.lt SP.ageMax m.age))
def SP.M : Mealy SPS SPI Bool := SP.step

def SP.init : SPS :=
  SPS.mk (SPSc.mk 0 0 0 0) (SPMon.mk SP.cap SP.cap SP.cap .false SP.cap .false 0)

------------------------------------------------------------------------------------
-- Equality of states, decided, and sound

def SP.bEq (a b : Bool) : Bool := match a, b with
  | .true, .true => .true
  | .false, .false => .true
  | _, _ => .false
def SP.bEq_sound : (a b : Bool) → SP.bEq a b = .true → a = b
  | .true, .true, e => rfl
  | .false, .false, e => rfl
  | .true, .false, e => absurd e.1
  | .false, .true, e => absurd e.1
def SP.nEq_sound : (a b : Nat) → Nat.beq a b = .true → a = b
  | .zero, .zero, e => rfl
  | .zero, .succ b, e => absurd e.1
  | .succ a, .zero, e => absurd e.1
  | .succ a, .succ b, e => Eq.congrArg Nat.succ (SP.nEq_sound a b e)
def SP.and_l : (a b : Bool) → Bool.and a b = .true → a = .true
  | .true, _, e => rfl
  | .false, _, e => absurd e.1
def SP.and_r : (a b : Bool) → Bool.and a b = .true → b = .true
  | .true, _, e => e
  | .false, _, e => absurd e.1

def SPSc.eqB (a b : SPSc) : Bool :=
  Bool.and (Nat.beq a.sst b.sst) (Bool.and (Nat.beq a.stimer b.stimer) (Bool.and (Nat.beq a.swe b.swe) (Nat.beq a.refPend b.refPend)))
def SPSc.eqB_sound (a b : SPSc) (e : SPSc.eqB a b = .true) : a = b :=
  let e1 := SP.nEq_sound a.sst b.sst (SP.and_l _ _ e);
  let r1 := SP.and_r _ _ e;
  let e2 := SP.nEq_sound a.stimer b.stimer (SP.and_l _ _ r1);
  let r2 := SP.and_r _ _ r1;
  let e3 := SP.nEq_sound a.swe b.swe (SP.and_l _ _ r2);
  let e4 := SP.nEq_sound a.refPend b.refPend (SP.and_r _ _ r2);
  Eq.trans (Eq.congrArg (fun (x : Nat) => SPSc.mk x a.stimer a.swe a.refPend) e1)
    (Eq.trans (Eq.congrArg (fun (x : Nat) => SPSc.mk b.sst x a.swe a.refPend) e2)
      (Eq.trans (Eq.congrArg (fun (x : Nat) => SPSc.mk b.sst b.stimer x a.refPend) e3)
        (Eq.congrArg (fun (x : Nat) => SPSc.mk b.sst b.stimer b.swe x) e4)))

def SPMon.eqB (a b : SPMon) : Bool :=
  Bool.and (Nat.beq a.sAct b.sAct) (Bool.and (Nat.beq a.sPre b.sPre) (Bool.and (Nat.beq a.sRw b.sRw)
    (Bool.and (SP.bEq a.wasWr b.wasWr) (Bool.and (Nat.beq a.sRef b.sRef) (Bool.and (SP.bEq a.open b.open) (Nat.beq a.age b.age))))))
def SPMon.eqB_sound (a b : SPMon) (e : SPMon.eqB a b = .true) : a = b :=
  let e1 := SP.nEq_sound a.sAct b.sAct (SP.and_l _ _ e);
  let r1 := SP.and_r _ _ e;
  let e2 := SP.nEq_sound a.sPre b.sPre (SP.and_l _ _ r1);
  let r2 := SP.and_r _ _ r1;
  let e3 := SP.nEq_sound a.sRw b.sRw (SP.and_l _ _ r2);
  let r3 := SP.and_r _ _ r2;
  let e4 := SP.bEq_sound a.wasWr b.wasWr (SP.and_l _ _ r3);
  let r4 := SP.and_r _ _ r3;
  let e5 := SP.nEq_sound a.sRef b.sRef (SP.and_l _ _ r4);
  let r5 := SP.and_r _ _ r4;
  let e6 := SP.bEq_sound a.open b.open (SP.and_l _ _ r5);
  let e7 := SP.nEq_sound a.age b.age (SP.and_r _ _ r5);
  Eq.trans (Eq.congrArg (fun (x : Nat) => SPMon.mk x a.sPre a.sRw a.wasWr a.sRef a.open a.age) e1)
    (Eq.trans (Eq.congrArg (fun (x : Nat) => SPMon.mk b.sAct x a.sRw a.wasWr a.sRef a.open a.age) e2)
    (Eq.trans (Eq.congrArg (fun (x : Nat) => SPMon.mk b.sAct b.sPre x a.wasWr a.sRef a.open a.age) e3)
    (Eq.trans (Eq.congrArg (fun (x : Bool) => SPMon.mk b.sAct b.sPre b.sRw x a.sRef a.open a.age) e4)
    (Eq.trans (Eq.congrArg (fun (x : Nat) => SPMon.mk b.sAct b.sPre b.sRw b.wasWr x a.open a.age) e5)
    (Eq.trans (Eq.congrArg (fun (x : Bool) => SPMon.mk b.sAct b.sPre b.sRw b.wasWr b.sRef x a.age) e6)
      (Eq.congrArg (fun (x : Nat) => SPMon.mk b.sAct b.sPre b.sRw b.wasWr b.sRef b.open x) e7))))))

------------------------------------------------------------------------------------
-- Sets of states: buckets by the scheduler's control state

def SP.Set : Type := List (SPSc × List SPMon)

def SP.memMon (m : SPMon) : List SPMon → Bool
  | .nil => .false
  | .cons x xs => Bool.or (SPMon.eqB m x) (SP.memMon m xs)
def SP.memIf (c here rest : Bool) : Bool := match c with
  | .true => here
  | .false => rest
def SP.mem (s : SPS) : SP.Set → Bool
  | .nil => .false
  | .cons b bs => SP.memIf (SPSc.eqB s.sc b.1) (SP.memMon s.mon b.2) (SP.mem s bs)
-- add a state (no check that it is new)
def SP.addMon (m : SPMon) (b : SPSc × List SPMon) : SPSc × List SPMon := (b.1, .cons m b.2)
def SP.add (s : SPS) : SP.Set → SP.Set
  | .nil => .cons (s.sc, .cons s.mon .nil) .nil
  | .cons b bs => match SPSc.eqB s.sc b.1 with
    | .true => .cons (SP.addMon s.mon b) bs
    | .false => .cons b (SP.add s bs)

-- every state of a set, and every input
def SP.allMon (f : SPS → Bool) (c : SPSc) : List SPMon → Bool
  | .nil => .true
  | .cons m ms => Bool.and (f (SPS.mk c m)) (SP.allMon f c ms)
def SP.all (f : SPS → Bool) : SP.Set → Bool
  | .nil => .true
  | .cons b bs => Bool.and (SP.allMon f b.1 b.2) (SP.all f bs)
def SP.inputs : List SPI :=
  .cons (SPI.mk .false .false .false) (.cons (SPI.mk .false .false .true) (.cons (SPI.mk .false .true .false)
  (.cons (SPI.mk .false .true .true) (.cons (SPI.mk .true .false .false) (.cons (SPI.mk .true .false .true)
  (.cons (SPI.mk .true .true .false) (.cons (SPI.mk .true .true .true) .nil)))))))
def SP.allI (g : SPI → Bool) : Bool :=
  Bool.and (g (SPI.mk .false .false .false)) (Bool.and (g (SPI.mk .false .false .true)) (Bool.and (g (SPI.mk .false .true .false))
  (Bool.and (g (SPI.mk .false .true .true)) (Bool.and (g (SPI.mk .true .false .false)) (Bool.and (g (SPI.mk .true .false .true))
  (Bool.and (g (SPI.mk .true .true .false)) (g (SPI.mk .true .true .true))))))))

------------------------------------------------------------------------------------
-- The reachable states: breadth first, from the initial state

def SP.succs (s : SPS) : List SPS := Hdl.map (fun (x : SPI) => (SP.step s x).1) SP.inputs
-- add the new ones among `xs` to `seen` and to the next frontier
def SP.visit : List SPS → SP.Set → List SPS → SP.Set × List SPS
  | .nil, seen, next => (seen, next)
  | .cons x xs, seen, next => match SP.mem x seen with
    | .true => SP.visit xs seen next
    | .false => SP.visit xs (SP.add x seen) (.cons x next)
def SP.expand : List SPS → SP.Set → List SPS → SP.Set × List SPS
  | .nil, seen, next => (seen, next)
  | .cons s ss, seen, next =>
    let r := SP.visit (SP.succs s) seen next;
    SP.expand ss r.1 r.2
def SP.bfs : Nat → SP.Set → List SPS → SP.Set
  | .zero, seen, _ => seen
  | .succ k, seen, frontier => match frontier with
    | .nil => seen
    | .cons _ _ =>
      let r := SP.expand frontier seen .nil;
      SP.bfs k r.1 r.2
def SP.reach : SP.Set := SP.bfs 1000 (SP.add SP.init .nil) (.cons SP.init .nil)

-- the check: the initial state is in, every step from a state in stays in and breaks
-- no rule
def SP.stepOk (s : SPS) : Bool :=
  SP.allI (fun (x : SPI) => Bool.and (SP.mem (SP.step s x).1 SP.reach) (Bool.not (SP.step s x).2))
def SP.check : Bool := Bool.and (SP.mem SP.init SP.reach) (SP.all SP.stepOk SP.reach)
def SP.count : Nat := List.foldl (fun (n : Nat) (b : SPSc × List SPMon) => n + List.length b.2) 0 SP.reach

------------------------------------------------------------------------------------
-- The proof

def SP.ok_true : SP.check = .true := refl .true

def SP.or_cases : (a b : Bool) → Bool.or a b = .true → a = .true ∨ b = .true
  | .true, _, e => Or.inl rfl
  | .false, b, e => Or.inr e
def SP.not_true : (a : Bool) → Bool.not a = .true → a = .false
  | .false, e => rfl
  | .true, e => absurd e.1

-- a monitor in a bucket's list satisfies what all of them do
def SP.memMon_all (f : SPS → Bool) (c : SPSc) (m : SPMon) :
    (ms : List SPMon) → SP.memMon m ms = .true → SP.allMon f c ms = .true → f (SPS.mk c m) = .true
  | .nil, hm, ha => absurd hm.1
  | .cons x xs, hm, ha => Or.elim (SP.or_cases (SPMon.eqB m x) (SP.memMon m xs) hm)
      (fun (e : SPMon.eqB m x = .true) =>
        Eq.substProp (fun (y : SPMon) => f (SPS.mk c y) = .true) (Eq.symm (SPMon.eqB_sound m x e)) (SP.and_l _ _ ha))
      (fun (h : SP.memMon m xs = .true) => SP.memMon_all f c m xs h (SP.and_r _ _ ha))

-- a member of a set satisfies what all of its states do (the bucket case, given the
-- claim for the rest of the set)
def SP.mem_allIf (f : SPS → Bool) (c : SPSc) (m : SPMon) (b : SPSc × List SPMon) (bs : SP.Set)
    (ih : SP.mem (SPS.mk c m) bs = .true → SP.all f bs = .true → f (SPS.mk c m) = .true) :
    (e : Bool) → SPSc.eqB c b.1 = e → SP.memIf e (SP.memMon m b.2) (SP.mem (SPS.mk c m) bs) = .true → SP.all f (.cons b bs) = .true →
    f (SPS.mk c m) = .true
  | .true, he, hm, ha =>
    Eq.substProp (fun (y : SPSc) => f (SPS.mk y m) = .true) (Eq.symm (SPSc.eqB_sound c b.1 he))
      (SP.memMon_all f b.1 m b.2 hm (SP.and_l _ _ ha))
  | .false, he, hm, ha => ih hm (SP.and_r _ _ ha)
def SP.mem_all (f : SPS → Bool) (c : SPSc) (m : SPMon) :
    (L : SP.Set) → SP.mem (SPS.mk c m) L = .true → SP.all f L = .true → f (SPS.mk c m) = .true
  | .nil, hm, ha => absurd hm.1
  | .cons b bs, hm, ha => SP.mem_allIf f c m b bs (SP.mem_all f c m bs) (SPSc.eqB c b.1) rfl hm ha
def SP.mem_all' (f : SPS → Bool) (L : SP.Set) (s : SPS) (hm : SP.mem s L = .true) (ha : SP.all f L = .true) : f s = .true :=
  SP.mem_all f s.sc s.mon L hm ha

-- every input
def SP.allI_spec (g : SPI → Bool) (h : SP.allI g = .true) : (x : SPI) → g x = .true
  | .mk .false .false .false => SP.and_l _ _ h
  | .mk .false .false .true => SP.and_l _ _ (SP.and_r _ _ h)
  | .mk .false .true .false => SP.and_l _ _ (SP.and_r _ _ (SP.and_r _ _ h))
  | .mk .false .true .true => SP.and_l _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ h)))
  | .mk .true .false .false => SP.and_l _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ h))))
  | .mk .true .false .true => SP.and_l _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ h)))))
  | .mk .true .true .false => SP.and_l _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ h))))))
  | .mk .true .true .true => SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ (SP.and_r _ _ h))))))

-- the reachable set is an invariant, and from it no step breaks a rule
def SP.inv (s : SPS) : Prop := SP.mem s SP.reach = .true
def SP.stepOk_of (s : SPS) (h : SP.inv s) : SP.stepOk s = .true :=
  SP.mem_all' SP.stepOk SP.reach s h (SP.and_r _ _ SP.ok_true)
def SP.inv_step (s : SPS) (x : SPI) (u : True) (h : SP.inv s) : SP.inv (SP.step s x).1 :=
  SP.and_l _ _ (SP.allI_spec _ (SP.stepOk_of s h) x)
def SP.inv_at (xs : Trace SPI) (t : Nat) : SP.inv (Mealy.stateAt SP.M SP.init xs t) :=
  Mealy.invariant SP.M SP.init xs (fun (x : SPI) => True) SP.inv (SP.and_l _ _ SP.ok_true) SP.inv_step
    (fun (u : Nat) => True.intro) t

-- The theorem: whatever the inputs, the scheduler's command breaks no timing rule in
-- any cycle, and no refresh waits more than `SP.ageMax` cycles.
def SP.safe (xs : Trace SPI) (t : Nat) : Mealy.outAt SP.M SP.init xs t = .false :=
  SP.not_true _ (SP.and_r _ _ (SP.allI_spec _ (SP.stepOk_of (Mealy.stateAt SP.M SP.init xs t) (SP.inv_at xs t)) (xs t)))
