import Hdl.Core
-- The timing record: every delay the controller keeps, in controller cycles (one cycle =
-- 4 memory clocks at 4:1), and the mode registers. `Timing.arty` is the MT41K128M16JT-125
-- at DDR3-800 with a 100 MHz controller clock (/workspace/wiz-notes/ddr3-design.md, §4):
-- each value is the datasheet minimum in ns divided by 10 ns, rounded up.
--
-- A gap of `k` here means: the next command may be issued `k` cycles after this one
-- (k = 1: the very next cycle). Every command is issued in the same phase of its cycle,
-- so `k` cycles are 4k memory clocks.

structure Timing where
  tRCD : Nat      -- ACT → RD/WR, same bank
  tRP : Nat       -- PRE → ACT (or REF)
  tRAS : Nat      -- ACT → PRE, same bank
  tRC : Nat       -- ACT → ACT, same bank
  tRFC : Nat      -- REF → any command
  tREFI : Nat     -- average refresh interval: the controller refreshes this often
  tWRP : Nat      -- WR → PRE: CWL + 4 + tWR memory clocks
  tRTP : Nat      -- RD → PRE
  tWTR : Nat      -- WR → RD (end of write data + tWTR)
  tRTW : Nat      -- RD → WR (bus turnaround)
  tMRD : Nat      -- MRS → MRS
  tMOD : Nat      -- MRS → non-MRS
  tZQinit : Nat   -- ZQCL → any command
  tXPR : Nat      -- CKE high → first command
  tReset : Nat    -- RESET# low (≥ 200 µs)
  tCke : Nat      -- RESET# high → CKE high (≥ 500 µs)
  mr0 : Nat
  mr1 : Nat
  mr2 : Nat
  mr3 : Nat
  wrLatency : Nat -- WR command (cycle t) → write data on DQ (cycle t + wrLatency)

-- MT41K128M16JT-125 at tCK = 2.5 ns, 100 MHz controller clock.
-- MR0 0x0520: BL8, CL 6, DLL reset, WR 6.  MR1 0x0006: DLL on, RZQ/7 (34 Ω, A1),
-- Rtt_nom RZQ/4 (60 Ω, A2).  MR2 0: CWL 5.  MR3 0.
-- Write data: WR in phase 3 of cycle t, CWL 5 → first beat at memory clock 4t + 8, the
-- start of cycle t + 2.
def Timing.arty : Timing :=
  Timing.mk 2 2 4 5 16 780 4 1 4 2 1 3 128 17 20000 50000 1312 6 0 0 2

-- The same with the long waits of initialisation shortened, for simulation (the model
-- checks against the record it is given, so the order and the gaps are still checked).
def Timing.sim : Timing :=
  Timing.mk 2 2 4 5 16 780 4 1 4 2 1 3 128 17 20 50 1312 6 0 0 2

-- Geometry: 8 banks, 16384 rows, 1024 columns of 16 bits; a burst (BL8) is 8 columns =
-- 16 bytes, so 2^24 bursts. A burst address: row (14) · bank (3) · column / 8 (7).
def Ddr3.rowBits : Nat := 14
def Ddr3.bankBits : Nat := 3
def Ddr3.colBits : Nat := 7
def Ddr3.addrBits : Nat := 24
